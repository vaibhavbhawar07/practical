import pandas as pd

# 1. Read CSV file
df = pd.read_csv("student_data.csv")

print("Original DataFrame:")
print(df)

# ---------------- FILTERING ----------------

# 2. Filter students with Marks greater than 80
filtered_marks = df[df["Marks"] > 80]

print("\nStudents with Marks greater than 80:")
print(filtered_marks)

# 3. Filter students with Attendance greater than 85
filtered_attendance = df[df["Attendance"] > 85]

print("\nStudents with Attendance greater than 85:")
print(filtered_attendance)

# 4. Filter B.Tech students
filtered_course = df[df["Course"] == "B.Tech"]

print("\nB.Tech Students:")
print(filtered_course)

# ---------------- SORTING ----------------

# 5. Sort by Marks in ascending order
sorted_marks_asc = df.sort_values(by="Marks")

print("\nStudents sorted by Marks (Ascending):")
print(sorted_marks_asc)

# 6. Sort by Marks in descending order
sorted_marks_desc = df.sort_values(by="Marks", ascending=False)

print("\nStudents sorted by Marks (Descending):")
print(sorted_marks_desc)

# 7. Sort by Attendance in descending order
sorted_attendance = df.sort_values(by="Attendance", ascending=False)

print("\nStudents sorted by Attendance (Descending):")
print(sorted_attendance)
